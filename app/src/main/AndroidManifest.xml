<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A wake-up alarm every 5 minutes (exact alarms are allowed for a sideloaded app), and a start after boot. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The apps it can keep up to date (Jobs.APPS): Android 11+ only shows an app the packages it names. -->
    <queries>
        <package android:name="org.smarttube.stable" />
    </queries>

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The Roku control port and the Pi's updates are plain http on the home network. -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true">

        <!-- The home screen tile: set-up steps, the feature switches, what was last done. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Finding and picking the TV, from the main screen. -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <service
            android:name=".LinkService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/link_service" />
        </service>

        <!-- Also the box's answer to "show inputs", which the launcher's Input button helper asks for:
             singleTask, so both opening it at once still gives one panel. -->
        <activity
            android:name=".InputPanelActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Panel">
            <intent-filter>
                <action android:name="com.android.tv.action.VIEW_INPUTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".Check"
            android:exported="false" />

        <receiver
            android:name=".TestRun"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.expertlizard56.boxkeeper.RUN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".Start"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
